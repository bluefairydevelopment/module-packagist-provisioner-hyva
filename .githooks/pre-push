#!/usr/bin/env bash
#
# pre-push for bluefairy/module-packagist-provisioner-hyva. Identical to the base package's.
#
# TWO JOBS, and both of them can refuse a push:
#
#   1. A BRANCH push that brings new commits must carry a CHANGELOG.md change,
#      read from every new commit's own files (M2MAP-656). (Since 1.1.0; tags are
#      skipped here because a tag names a commit already on the branch, so the
#      "new commits" query is empty and this rule rejected every tag push.)
#
#   2. A TAG push must pass the package's own gates FIRST - and every tag pushed
#      must name HEAD with a clean working tree, because the gates read the working
#      tree and a tag on any other commit would publish bytes nobody measured. M2MAP-594 / M2MAP-546:
#      before this, the only check between a red suite and a published tag was
#      the CHANGELOG heading - product-grid-export v1.0.6 was tagged with its own
#      regression test red. Now phpunit, phpcs, phpstan and `composer validate`
#      run against the tree being tagged and ANY non-zero exit refuses the push.
#      Exit codes are read, never output.
#
# INSTALL: this file is tracked (it used to be gitignored, which made "no hook"
# the default state of every fresh clone). One line per clone, once:
#
#     git config core.hooksPath .githooks
#
# Test/Unit/Package/TheReleaseGateIsArmedTest refuses the suite until that is
# done, so a clone cannot forget.
#
# ENVIRONMENT: the gates need a Magento root with this package installed and
# compiled. Export MAGENTO_ROOT before pushing a tag; the hook refuses a tag
# push without it rather than run the gates against nothing (a phpstan run
# over an uncompiled root reports 0 for the wrong reason - Gate 1 in
# prep-m2-extension-for-sale.md).
#
# CONTROL: this hook has been seen to refuse. On 2026-09-17 a deliberately red
# test was planted, `git push <bare-remote> v0.0.0-control` was attempted, and
# the push was refused with the phpunit exit code quoted. Re-run that control
# whenever this file changes; a release gate never seen to refuse is untested.

set -u

z40=0000000000000000000000000000000000000000
# Branches whose new commits carry no changelog change, judged ONE REF AT A TIME. This was a pair of
# flags OR'd across the whole push, so `git push origin a b` landed b with no changelog as long as
# a had one - one branch vouched for another (review round 3 of module-packagist-provisioner 1.2.2).
unlogged=""
tags_pushed=""
tag_shas=""

# Does a changelog path differ between the pushed tip and EVERY commit the remote already has
# at the boundary of this push? A per-commit "touched" test alone fails OPEN: a commit that adds
# an entry and a later commit that reverts it both touch the file, and the push lands with no
# changelog change at all (review of module-packagist-provisioner 1.2.2). Differing from ALL
# boundaries, not any, for the same reason merges are read with --cc.
changelog_paths="CHANGELOG.md"
changelog_differs() {
    local tip="$1" remote="$2" bounds b p present=false
    # A changelog deleted or renamed away also "differs" from the remote - and leaves none. So the
    # pushed tree must still carry one.
    for p in $changelog_paths; do
        git cat-file -e "${tip}:${p}" 2>/dev/null && present=true
    done
    $present || return 1
    if [ "$remote" != "$z40" ]; then
        bounds="$remote"
    else
        bounds=$(git rev-list --boundary "$tip" --not --remotes 2>/dev/null | sed -n 's/^-//p')
    fi
    # Nothing on the remote at all: the changelog is new because it exists at the tip.
    [ -z "$bounds" ] && return 0
    for b in $bounds; do
        # shellcheck disable=SC2086
        git diff --quiet "$b" "$tip" -- $changelog_paths && return 1
    done
    return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$z40" ] && continue

    case "$local_ref" in
        refs/tags/*)
            # EVERY tag, not the last one read: `git push --tags` can carry several, each
            # naming a different commit, and each is a release.
            tags_pushed="${tags_pushed} ${local_ref#refs/tags/}"
            tag_shas="${tag_shas} ${local_sha}"
            continue
            ;;
    esac

    # A remote sha this clone has never fetched cannot be diffed against. Treat it as a first
    # push. KNOWN LIMIT: that falls back on this clone's remote-tracking refs, so stale fetch
    # state can miscount which commits are new - `git fetch` first when this rule surprises you.
    if [ "$remote_sha" != "$z40" ] && ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        remote_sha=$z40
    fi

    # ONE diff-tree PER NEW COMMIT (M2MAP-656). This used to be
    # `echo "$new_commits" | xargs git diff-tree --no-commit-id -r --name-only`, and given several
    # commits at once diff-tree compares them against EACH OTHER - for a multi-commit first push
    # it printed nothing, so the rule refused every such push with a changelog in it. It failed
    # closed, which is why nobody reported it: a gate that refuses everything is learned around
    # with --no-verify. On an existing branch it diffed only the two tips, so a commit and its
    # revert in one push netted to nothing and slipped through. Flags, each load-bearing:
    #   --root  a root commit has no parent and otherwise reports no files;
    #   --cc    a merge commit otherwise reports none either; NOT -m, which lists a file changed
    #           against ANY parent and lets an already-pushed changelog count again when an old
    #           branch is merged (fail OPEN). --cc lists only what the merge itself introduced.
    if [ "$remote_sha" = "$z40" ]; then
        new_commits=$(git log --format="%H" "$local_sha" --not --remotes 2>/dev/null)
    else
        new_commits=$(git rev-list "${remote_sha}..${local_sha}")
    fi
    # A branch pointing at commits the remote already has carries nothing to log.
    [ -z "$new_commits" ] && continue

    changed=""
    for c in $new_commits; do
        changed="${changed}$(git diff-tree --cc --no-commit-id -r --root --name-only "$c")
"
    done

    if ! { echo "$changed" | grep -q "^CHANGELOG.md$" \
        && changelog_differs "$local_sha" "$remote_sha"; }; then
        unlogged="${unlogged} ${local_ref#refs/heads/}"
    fi
done

if [ -n "$unlogged" ]; then
    echo "" >&2
    echo "  Push rejected: CHANGELOG.md has not been updated." >&2
    echo "  Branch(es) with new commits and no changelog change:${unlogged}" >&2
    echo "  Add an entry to CHANGELOG.md and commit it before pushing." >&2
    echo "" >&2
    exit 1
fi

if [ -n "$tags_pushed" ]; then
    root="$(git rev-parse --show-toplevel)"
    cd "$root" || exit 1

    # THE GATES RUN ON THE WORKING TREE, so the working tree must BE the commit being tagged.
    # Without this, tagging an older commit - or tagging with an uncommitted fix on disk - ran
    # every gate against bytes the tag does not contain. An annotated tag's sha is the tag
    # object, hence ^{commit}. (Found in review of module-order-comments 1.1.1.)
    head=$(git rev-parse HEAD)
    for sha in $tag_shas; do
        target=$(git rev-parse "${sha}^{commit}" 2>/dev/null)
        if [ "$target" != "$head" ]; then
            echo "" >&2
            echo "  Tag push refused: a tag points at ${target:-an unknown object}, but HEAD is ${head}." >&2
            echo "  The gates measure the working tree. Check out the commit you are tagging and retry." >&2
            echo "" >&2
            exit 1
        fi
    done
    if [ -n "$(git status --porcelain)" ]; then
        echo "" >&2
        echo "  Tag push refused: the working tree has uncommitted or untracked changes." >&2
        echo "  The gates would measure them and the tag would not contain them. Commit or stash, then retry." >&2
        echo "" >&2
        exit 1
    fi

    if [ -z "${MAGENTO_ROOT:-}" ] || [ ! -f "${MAGENTO_ROOT}/vendor/bin/phpunit" ]; then
        echo "" >&2
        echo "  Tag push refused: MAGENTO_ROOT is not set to a Magento install with vendor/bin/phpunit." >&2
        echo "  The package gates have to run against the tree being tagged. Export MAGENTO_ROOT and retry." >&2
        echo "" >&2
        exit 1
    fi

    echo "pre-push: running the release gates for tag(s)${tags_pushed} against ${MAGENTO_ROOT}" >&2

    # One private directory per run for the logs and phpstan's cache. Fixed names under /tmp
    # were predictable - another local user could plant a symlink there. A fresh cache per run
    # also stops phpstan replaying another MAGENTO_ROOT's verdict (its cache ignores the root).
    run_dir=$(mktemp -d "${TMPDIR:-/tmp}/packagist-provisioner-pre-push.XXXXXX") || exit 1

    gate() {
        local name="$1"; shift
        "$@" >"$run_dir/$name.log" 2>&1
        local status=$?
        if [ "$status" -ne 0 ]; then
            echo "" >&2
            echo "  Tag push refused: ${name} exited ${status}. Log: $run_dir/${name}.log" >&2
            echo "  A tag is a release. Fix it, or do not tag it." >&2
            echo "" >&2
            exit "$status"
        fi
        echo "pre-push: ${name} exit 0" >&2
    }

    gate composer-validate composer validate --no-check-publish --quiet
    gate phpunit env MAGENTO_ROOT="$MAGENTO_ROOT" "$MAGENTO_ROOT/vendor/bin/phpunit" -c phpunit.xml.dist
    gate phpcs "$MAGENTO_ROOT/vendor/bin/phpcs" --standard=phpcs.xml.dist --warning-severity=0 -q .
    gate phpstan env MAGENTO_ROOT="$MAGENTO_ROOT" TMPDIR="$run_dir/phpstan" "$MAGENTO_ROOT/vendor/bin/phpstan" analyse --no-progress --memory-limit=2G

    # Kept on failure (the refusal names the log); nothing to read on success.
    rm -rf "$run_dir"
fi

exit 0
