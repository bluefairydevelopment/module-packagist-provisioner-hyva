<?xml version="1.0"?>
<!--
    Gate 1 coding standard for module-packagist-provisioner. Run from the site's Magento
    root, against this module's path:

        <magento-root>/vendor/bin/phpcs standard=<this-file> <module-path>

    (flag name omitted above to avoid a literal double hyphen inside this XML
    comment, which phpcs' parser rejects; it is the usual two-hyphen "standard"
    option.)

    Exclusions mirror the house ruleset established for the Printify packages
    and module-product-grid-export — same reasoning, not module-specific:
    docblock-format opinions and pure formatting sniffs that phpcbf can rewrite
    without changing behaviour. Nothing here suppresses a sniff that could hide
    a real defect; EmptyBlock and DiscouragedFunction are deliberately NOT
    excluded for that reason.
-->
<ruleset name="BlueFairyPackagistProvisionerHyva">
    <description>Magento 2 coding standard for module-packagist-provisioner-hyva.</description>

    <rule ref="Magento2">
        <exclude name="Magento2.Annotation.MethodAnnotationStructure"/>
        <exclude name="Magento2.Annotation.MethodArguments"/>
        <exclude name="Magento2.Commenting.ClassPropertyPHPDocFormatting"/>
        <exclude name="Magento2.Commenting.ClassAndInterfacePHPDocFormatting"/>

        <exclude name="PSR2.Methods.FunctionCallSignature"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace"/>
        <exclude name="Squiz.ControlStructures.ControlSignature"/>
        <exclude name="PEAR.ControlStructures.ControlSignature"/>
        <exclude name="Generic.Files.LineLength"/>
        <exclude name="Magento2.Whitespace.MultipleEmptyLines"/>
    </rule>

    <file>.</file>

    <exclude-pattern>*/Test/*</exclude-pattern>
    <exclude-pattern>*/docs/*</exclude-pattern>
    <exclude-pattern>*/.idea/*</exclude-pattern>
    <exclude-pattern>*/.cache/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php,phtml"/>
    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
