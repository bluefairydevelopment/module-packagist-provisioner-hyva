<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="customer.account.packagist.extensions"
                   template="BlueFairy_PackagistProvisionerHyva::account/extensions.phtml"
                   after="customer_account_dashboard_address">
                <arguments>
                    <argument name="view_model" xsi:type="object">BlueFairy\PackagistProvisionerHyva\ViewModel\LicenceListViewModel</argument>
                    <!-- M2MAP-639: the store's own support address, not ours. -->
                    <argument name="support_contact" xsi:type="object">BlueFairy\PackagistProvisioner\ViewModel\SupportContact</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
