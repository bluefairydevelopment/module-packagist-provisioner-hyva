<?php declare(strict_types=1);

use BlueFairy\PackagistProvisionerHyva\ViewModel\OrderLicenceViewModel;
use BlueFairy\PackagistProvisioner\Api\Data\LicenceInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/**
 * BlueFairy - PackagistProvisionerHyva
 *
 * Order Detail — Packagist credentials block.
 *
 * Copyright © 2026 Blue Fairy Development. All rights reserved.
 *
 * @var OrderLicenceViewModel $viewModel
 * @var Template $block
 * @var Escaper $escaper
 */

$viewModel = $block->getData('view_model');
$orderId = $viewModel->getCurrentOrderId();
$entries = $viewModel->getLicencesForOrder($orderId);

if (empty($entries)) {
    return;
}
?>
<div class="box box-order-extensions mt-4">
    <strong class="box-title"><?= $escaper->escapeHtml(__('Extension Credentials')) ?></strong>
    <div class="box-content space-y-4 mt-2">
        <?php foreach ($entries as $entry):
            /** @var LicenceInterface $licence */
            $licence = $entry['licence'];
            $token = $entry['decrypted_token'];
            ?>
            <div
                class="border border-gray-200 rounded p-3"
                x-data="{ tokenVisible: false, copied: false, copyText(t) { if(navigator.clipboard) navigator.clipboard.writeText(t).then(()=>{this.copied=true;setTimeout(()=>this.copied=false,2000)}); } }"
            >
                <p class="font-mono text-sm font-semibold mb-1"><?= $escaper->escapeHtml($licence->getPackageName()) ?></p>

                <?php if ($licence->getStatus() === LicenceInterface::STATUS_ACTIVE && !$viewModel->isStepUpVerified()): ?>
                    <?php /* M2MAP-260 - see account/extensions.phtml. */ ?>
                    <p class="text-sm text-gray-600">
                        <?= $escaper->escapeHtml(__('Your credentials are hidden until you confirm your password.')) ?>
                        <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/licences')) ?>"
                           class="text-blue-600 hover:underline"><?= $escaper->escapeHtml(__('Verify to view credentials')) ?></a>
                    </p>
                <?php elseif ($licence->getStatus() === LicenceInterface::STATUS_ACTIVE && $licence->getRepoUrl() && $token): ?>
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-gray-500 w-20 shrink-0"><?= $escaper->escapeHtml(__('Repository')) ?></span>
                            <code class="text-xs bg-gray-100 px-2 py-1 rounded flex-1 truncate"><?= $escaper->escapeHtml((string)$licence->getRepoUrl()) ?></code>
                            <button @click="copyText('<?= $escaper->escapeJs((string)$licence->getRepoUrl()) ?>')" class="text-xs text-blue-600 hover:underline"><?= $escaper->escapeHtml(__('Copy')) ?></button>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-gray-500 w-20 shrink-0"><?= $escaper->escapeHtml(__('Token')) ?></span>
                            <code class="text-xs bg-gray-100 px-2 py-1 rounded flex-1 truncate" x-text="tokenVisible ? '<?= $escaper->escapeJs($token) ?>' : '●●●●●●●●●●●●●●●●●●●●'"></code>
                            <button @click="tokenVisible=!tokenVisible" class="text-xs text-blue-600 hover:underline" x-text="tokenVisible ? '<?= $escaper->escapeJs(__('Hide')->render()) ?>' : '<?= $escaper->escapeJs(__('Reveal')->render()) ?>'"></button>
                        </div>
                        <p x-show="copied" class="text-xs text-green-600"><?= $escaper->escapeHtml(__('Copied!')) ?></p>
                    </div>
                <?php elseif ($licence->getStatus() === LicenceInterface::STATUS_PENDING): ?>
                    <p class="text-sm text-blue-700"><?= $escaper->escapeHtml($viewModel->getPendingMessage($licence)) ?></p>
                <?php elseif ($licence->getStatus() === LicenceInterface::STATUS_FAILED): ?>
                    <p class="text-sm text-red-700"><?= $escaper->escapeHtml($viewModel->getFailedMessage($licence)) ?></p>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
</div>
